# PR-00 isolated UI env. Copy to skyvern-frontend/.env.enterprise (gitignored).
# Do not copy the placeholder API key from skyvern-frontend/.env.example.
# Leave the API key empty so the UI entrypoint can read the isolated
# .enterprise-data/.skyvern/credentials.toml test token.

VITE_BROWSER_STREAMING_MODE=cdp
VITE_API_BASE_URL=http://localhost:18000/api/v1
VITE_ARTIFACT_API_BASE_URL=http://localhost:19090
VITE_WSS_BASE_URL=ws://localhost:18000/api/v1
VITE_SKYVERN_API_KEY=
VITE_ENABLE_LOG_ARTIFACTS=false
VITE_ENABLE_CODE_BLOCK=true
VITE_ENABLE_2FA_NOTIFICATIONS=true
