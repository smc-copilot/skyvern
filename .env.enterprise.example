# PR-00 Enterprise Compose variables only.
# Do not put production DSNs, API keys, cookies, or real passwords here.
#
# Create a local env file (never commit it):
#   cp .env.example .env.enterprise
#   cat .env.enterprise.example >> .env.enterprise
# Then replace ENTERPRISE_POSTGRES_PASSWORD with a random alphanumeric value.
# Do not overwrite an existing .env.

SKYVERN_BACKEND_ENV_FILE=.env.enterprise
SKYVERN_FRONTEND_ENV_FILE=skyvern-frontend/.env.enterprise

ENTERPRISE_POSTGRES_USER=skyvern_pr00
ENTERPRISE_POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-value
ENTERPRISE_POSTGRES_DB=skyvern_pr00

ENTERPRISE_API_PORT=18000
ENTERPRISE_VNC_PORT=16080
ENTERPRISE_UI_PORT=18080
ENTERPRISE_ARTIFACT_PORT=19090

# Build identity is generated by scripts/enterprise/build_metadata.py into
# .enterprise-data/build.env. Do not hand-write SKYVERN_BUILD_SHA.
